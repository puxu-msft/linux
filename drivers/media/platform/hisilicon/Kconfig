comment "HiSilicon media platform drivers"

source "drivers/media/platform/hisilicon/histb-vdec/Kconfig"
source "drivers/media/platform/hisilicon/histb-venc/Kconfig"

config VIDEO_HISTB_JPGD
	tristate "HiSilicon HiSTB JPEG decoder driver"
	depends on ARCH_HISI || COMPILE_TEST
	depends on V4L_MEM2MEM_DRIVERS
	depends on VIDEO_DEV
	select VIDEOBUF2_DMA_CONTIG
	select VIDEOBUF2_VMALLOC
	select V4L2_MEM2MEM_DEV
	select V4L2_JPEG_HELPER
	help

	  Support for the JPGD hardware JPEG decoder on HiSilicon Hi3798MV100
	  and Hi3716CV200 set-top-box SoCs. The driver parses the baseline JPEG
	  header in the kernel, expands the quantiser and Huffman tables into
	  the forms the block expects, and decodes one picture per mem2mem job
	  into 8-bit semi-planar YUV.

	  To compile this driver as a module, choose M here: the module will be
	  called histb-jpgd.

config VIDEO_HISTB_JPGE
	tristate "HiSilicon HiSTB JPEG encoder driver"
	depends on ARCH_HISI || COMPILE_TEST
	depends on V4L_MEM2MEM_DRIVERS
	depends on VIDEO_DEV
	select VIDEOBUF2_DMA_CONTIG
	select VIDEOBUF2_VMALLOC
	select V4L2_MEM2MEM_DEV
	select V4L2_JPEG_HELPER
	help

	  Support for the JPGE hardware JPEG encoder on HiSilicon Hi3798MV100
	  and Hi3716CV200 set-top-box SoCs. The driver scales the standard
	  quantiser tables for the requested quality, writes the JFIF header the
	  block does not produce itself, and encodes one 8-bit semi-planar
	  picture per mem2mem job.

	  To compile this driver as a module, choose M here: the module will be
	  called histb-jpge.

config VIDEO_HISTB_VPSS
	tristate "HiSilicon HiSTB video processing subsystem driver"
	depends on ARCH_HISI || COMPILE_TEST
	depends on V4L_MEM2MEM_DRIVERS
	depends on VIDEO_DEV
	select VIDEOBUF2_DMA_CONTIG
	select V4L2_MEM2MEM_DEV
	help

	  Support for the VPSS video processing block on HiSilicon Hi3798MV100
	  set-top-box SoCs. The driver exposes it as a mem2mem device that
	  converts a frame between YUV layouts, scales, rotates and
	  de-interlaces a frame. The vpss_v4_0 generation, as Hi3798MV200H
	  carries it, runs the same jobs through a per-channel descriptor
	  instead of a flat image.

	  To compile this driver as a module, choose M here: the module will be
	  called histb-vpss.
